# =============================================================================
# NewPython Build System Configuration (Part 1: Variables and Core Targets)
# =============================================================================

VERSION=        3.12
EXE=
EXENAME=        koko
PROGRAM=        $(EXENAME)$(EXE)
PYTHON=         $(EXENAME)

top_srcdir=	@top_srcdir@
srcdir=		@srcdir@
VPATH=		@srcdir@

# インストール先のカスタム指定（標準環境と完全に隔離）
prefix=		@prefix@
exec_prefix=	@exec_prefix@
bindir=		@bindir@
libdir=		@libdir@
includedir=	@includedir@
mandir=		@mandir@
datarootdir=	@datarootdir@

# コンパイラと基本フラグの設定
CC=		@CC@
CXX=		@CXX@
MAINCC=		@MAINCC@
LINKCC=		@LINKCC@
AR=		@AR@
RANLIB=		@RANLIB@
READELF=	@READELF@
SOABI=		@SOABI@
LDVERSION=	@LDVERSION@
GITVERSION=	@GITVERSION@
GITTAG=		@GITTAG@
GITBRANCH=	@GITBRANCH@

# コンパイルオプション
CFLAGS=		@CFLAGS@
CPPFLAGS=	@CPPFLAGS@
LDFLAGS=	@LDFLAGS@
LIBS=		@LIBS@
MODLIBS=	@MODLIBS@

COREPYTHONPATH=	$(srcdir)/Lib
BUILDPYTHON=	$(PROGRAM)
OBJDIR=		.
SIGNAL_OBJS=	@SIGNAL_OBJS@
DYNLOADFILE=	@DYNLOADFILE@
IO_H=		$(srcdir)/Modules/_io/_iomodule.h
SUBDIRSTOO=	Include Lib Misc UserAlgos

PYTHON_HEADERS= \
 $(srcdir)/Include/Python.h \
 $(srcdir)/Include/abstract.h \
 $(srcdir)/Include/bltinmodule.h \
 $(srcdir)/Include/compile.h \
 $(srcdir)/Include/eval.h \
 $(srcdir)/Include/object.h \
 $(srcdir)/Include/objimpl.h \
 $(srcdir)/Include/pyerror.h \
 $(srcdir)/Include/pylifecycle.h \
 $(srcdir)/Include/pymem.h \
 $(srcdir)/Include/pythonrun.h \
 $(srcdir)/Include/sysmodule.h \
 $(srcdir)/Include/ceval.h

SHAREDMODS=	@SHAREDMODS@
EXT_SUFFIX=	@EXT_SUFFIX@
GRAMMAR_H=	$(srcdir)/Include/internal/pycore_ast.h
GRAMMAR_C=	$(srcdir)/Python/Python-ast.c
GRAMMAR_INPUT=	$(srcdir)/Grammar/python.gram

# ビルドに必要なコアオブジェクトの定義
# _typesmodule.o を追加しました
PYTHON_OBJS=	\
    Modules/_typesmodule.o \
    Modules/_threadmodule.o \
    Modules/arraymodule.o \
    Modules/cmathmodule.o \
    Modules/mathmodule.o \
    Modules/posixmodule.o \
    Python/_warnings.o \
    Python/Python-ast.o \
    Python/asdl.o \
    Python/ast.o \
    Python/ast_opt.o \
    Python/bltinmodule.o \
    Python/ceval.o \
    Python/codecs.o \
    Python/compile.o \
    Python/context.o \
    Python/dynamic_annotations.o \
    Python/errors.o \
    Python/frame.o \
    Python/frozeninit.o \
    Python/getargs.o \
    Python/getcompiler.o \
    Python/getcopyright.o \
    Python/getplatform.o \
    Python/getversion.o \
    Python/initconfig.o \
    Python/marshal.o \
    Python/modsupport.o \
    Python/mysnprintf.o \
    Python/mystrtoul.o \
    Python/pathconfig.o \
    Python/preconfig.o \
    Python/pyarena.o \
    Python/pyctype.o \
    Python/pyfpe.o \
    Python/pyhash.o \
    Python/pylifecycle.o \
    Python/pymem.o \
    Python/pystate.o \
    Python/pystrcmp.o \
    Python/pystrtod.o \
    Python/dtoa.o \
    Python/pytime.o \
    Python/pythonrun.o \
    Python/specialize.o \
    Python/structmember.o \
    Python/sysmodule.o \
    Python/traceback.o \
    Objects/abstract.o \
    Objects/boolobject.o \
    Objects/bytes_methods.o \
    Objects/bytearrayobject.o \
    Objects/bytesobject.o \
    Objects/call.o \
    Objects/capsule.o \
    Objects/cellobject.o \
    Objects/classobject.o \
    Objects/codeobject.o \
    Objects/complexobject.o \
    Objects/descrobject.o \
    Objects/enumobject.o \
    Objects/exceptions.o \
    Objects/genericaliasobject.o \
    Objects/genobject.o \
    Objects/fileobject.o \
    Objects/floatobject.o \
    Objects/frameobject.o \
    Objects/funcobject.o \
    Objects/interpreteridobject.o \
    Objects/iterobject.o \
    Objects/listobject.o \
    Objects/longobject.o \
    Objects/dictobject.o \
    Objects/odictobject.o \
    Objects/memoryobject.o \
    Objects/methodobject.o \
    Objects/moduleobject.o \
    Objects/namespaceobject.o \
    Objects/object.o \
    Objects/obmalloc.o \
    Objects/picklebufobject.o \
    Objects/rangeobject.o \
    Objects/setobject.o \
    Objects/sliceobject.o \
    Objects/structseq.o \
    Objects/tupleobject.o \
    Objects/typeobject.o \
    Objects/unicodeobject.o \
    Objects/unicodectype.o \
    Objects/unionobject.o \
    Objects/weakrefobject.o \
    @MODULE_OBJS@ \
    $(SIGNAL_OBJS)

LIBRARY_OBJS=	\
    Modules/getbuildinfo.o \
    $(PARSER_OBJS) \
    $(OBJECT_OBJS) \
    $(PYTHON_OBJS) \
    $(MODULE_OBJS) \
    $(SIGNAL_OBJS) \
    $(DYNLOADFILE)

MAINOBJ=	Modules/python.o

all:		build_all

build_all:	$(PROGRAM) platform

$(PROGRAM):	$(LIBRARY_OBJS) $(MAINOBJ)
	$(LINKCC) $(LDFLAGS) $(LINKFORSHARED) -o $@ $(MAINOBJ) $(LIBRARY_OBJS) $(LIBS) $(MODLIBS)

# 各種C言語ソースファイルからオブジェクトファイルを生成する共通ルール
.c.o:
	$(CC) -c $(CFLAGS) $(CPPFLAGS) -o $@ $<

# メインエントリポイントのコンパイル
Modules/python.o: $(srcdir)/Modules/python.c
	$(CC) -c $(CFLAGS) $(CPPFLAGS) -o $@ $(srcdir)/Modules/python.c

# _typesmodule の明示的なビルドルール
Modules/_typesmodule.o: $(srcdir)/Modules/_typesmodule.c $(PYTHON_HEADERS)
	$(CC) -c $(CFLAGS) $(CPPFLAGS) -o $@ $(srcdir)/Modules/_typesmodule.c

# koko専用の文法定義（python.gram）からパーサーを自動生成する超重要ターゲット
regen-grammar:
	@echo "========================================================="
	@echo " Generating NewPython (koko) Grammar and AST Components "
	@echo "========================================================="
	$(PYTHON) -m pegen $(GRAMMAR_INPUT) $(srcdir)/Grammar/Tokens -o $(srcdir)/Parser/parser.c

# 構文解析オブジェクトのコンパイルルール
Parser/parser.o: $(srcdir)/Parser/parser.c
	$(CC) -c $(CFLAGS) $(CPPFLAGS) -o $@ $(srcdir)/Parser/parser.c
Parser/peg_api.o: $(srcdir)/Parser/peg_api.c
	$(CC) -c $(CFLAGS) $(CPPFLAGS) -o $@ $(srcdir)/Parser/peg_api.c

# Pythonコアモジュールの依存関係とビルド
Python/sysmodule.o: $(srcdir)/Python/sysmodule.c Makefile
	$(CC) -c $(CFLAGS) $(CPPFLAGS) -DEXECENAME='"$(EXENAME)"' -o $@ $(srcdir)/Python/sysmodule.c
Python/pathconfig.o: $(srcdir)/Python/pathconfig.c Makefile
	$(CC) -c $(CFLAGS) $(CPPFLAGS) -DPREFIX='"$(prefix)"' -o $@ $(srcdir)/Python/pathconfig.c

# クリーナップ処理
clean:
	find . -name '*.o' -delete
	find . -name '*.gch' -delete
	rm -f $(PROGRAM)

clobber: clean
	rm -f Makefile config.status config.log

# インストール関連ルール
install:	altinstall
altinstall:	commoninstall
commoninstall:	check-version bininstall libinstall inclinstall

bininstall:
	@echo "========================================================="
	@echo " Installing NewPython Binary securely as '$(EXENAME)'    "
	@echo "========================================================="
	@if test ! -d $(DESTDIR)$(bindir); then \
		echo "Creating directory $(DESTDIR)$(bindir)"; \
		$(INSTALL) -d -m $(DIRMODE) $(DESTDIR)$(bindir); \
	fi
	$(INSTALL_PROGRAM) $(PROGRAM) $(DESTDIR)$(bindir)/$(PROGRAM)
	-if test -f $(DESTDIR)$(bindir)/$(EXENAME)-$(VERSION); then \
		rm -f $(DESTDIR)$(bindir)/$(EXENAME)-$(VERSION); \
	fi
	(cd $(DESTDIR)$(bindir); ln -s $(PROGRAM) $(EXENAME)-$(VERSION))

libinstall:
	@echo "========================================================="
	@echo " Installing NewPython Standard Library Modules          "
	@echo "========================================================="
	@for i in $(DESTDIR)$(libdir) $(DESTDIR)$(libdir)/python$(VERSION); \
	do \
		if test ! -d $$i; then \
			echo "Creating directory $$i"; \
			$(INSTALL) -d -m $(DIRMODE) $$i; \
		fi; \
	done
	@echo "Copying standard library files from $(COREPYTHONPATH)..."
	@cp -pPR $(COREPYTHONPATH)/* $(DESTDIR)$(libdir)/python$(VERSION)/

inclinstall:
	@if test ! -d $(DESTDIR)$(includedir); then \
		$(INSTALL) -d -m $(DIRMODE) $(DESTDIR)$(includedir); \
	fi
	@if test ! -d $(DESTDIR)$(includedir)/python$(VERSION); then \
		$(INSTALL) -d -m $(DIRMODE) $(DESTDIR)$(includedir)/python$(VERSION); \
	fi
	@$(INSTALL_DATA) $(srcdir)/Include/*.h $(DESTDIR)$(includedir)/python$(VERSION)/

check-version:
	@echo "Building NewPython version $(VERSION) under name '$(EXENAME)'..."

.PHONY: all build_all check-version install altinstall commoninstall bininstall libinstall inclinstall clean clobber
